pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = credentials('docker-registry')
        SONARQUBE_TOKEN = credentials('sonarqube-token')
        NEXUS_IQ_TOKEN = credentials('nexus-iq-token')
        TRIVY_TOKEN = credentials('trivy-token')
        JAVA_VERSION = '11'
        MAVEN_OPTS = '-Dmaven.repo.local=${WORKSPACE}/.m2/repository'
        DOCKER_IMAGE_NAME = 'hobbie-backend'
        DOCKER_TAG = "${env.BUILD_NUMBER}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    
    stages {
        stage('PR Validation') {
            when {
                changeRequest()
            }
            steps {
                script {
                    // PR Title Check
                    if (!env.CHANGE_TITLE =~ /^(feat|fix|docs|style|refactor|test|chore)(\\(.+\\))?: .+/) {
                        error("PR title must follow conventional commit format: type(scope): description")
                    }
                    
                    // Check for required sections in PR description
                    if (!env.CHANGE_DESCRIPTION.contains('## Type of Change') || 
                        !env.CHANGE_DESCRIPTION.contains('## Testing') || 
                        !env.CHANGE_DESCRIPTION.contains('## Checklist')) {
                        error("PR description must include Type of Change, Testing, and Checklist sections")
                    }
                }
            }
        }
        
        stage('Secret Scanning') {
            steps {
                script {
                    // TruffleHog secret scanning
                    sh '''
                        trufflehog filesystem . \
                            --exclude_paths=.gitignore \
                            --json \
                            --output=trufflehog-results.json || true
                    '''
                    
                    // Parse results and fail if secrets found
                    script {
                        def trufflehogResults = readJSON file: 'trufflehog-results.json'
                        if (trufflehogResults.size() > 0) {
                            error("Secrets detected in repository! Please review and remove them.")
                        }
                    }
                }
            }
        }
        
        stage('Setup Java & Maven') {
            steps {
                tool name: "JDK ${JAVA_VERSION}", type: 'jdk'
                sh 'java -version'
                sh 'mvn -version'
            }
        }
        
        stage('Code Quality - SonarQube') {
            steps {
                dir('spring-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn clean verify sonar:sonar \
                                -Dsonar.projectKey=hobbie-backend \
                                -Dsonar.host.url=${SONAR_HOST_URL} \
                                -Dsonar.login=${SONARQUBE_TOKEN} \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
            post {
                always {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error("Pipeline aborted due to quality gate failure: ${qg.status}")
                        }
                    }
                }
            }
        }
        
        stage('Unit Tests') {
            steps {
                dir('spring-backend') {
                    sh '''
                        mvn clean test-compile surefire:test jacoco:report
                    '''
                }
            }
            post {
                always {
                    // Publish unit test results
                    publishTestResults testResultsPattern: 'spring-backend/target/surefire-reports/*.xml'
                    
                    // Publish JaCoCo coverage report
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'spring-backend/target/site/jacoco',
                        reportFiles: 'index.html',
                        reportName: 'Unit Test Coverage'
                    ])
                    
                    // Check coverage thresholds
                    script {
                        def jacocoReport = readXML file: 'spring-backend/target/site/jacoco/jacoco.xml'
                        def instructionCoverage = jacocoReport.counter[0].@covered.toDouble() / (jacocoReport.counter[0].@covered.toDouble() + jacocoReport.counter[0].@missed.toDouble()) * 100
                        def branchCoverage = jacocoReport.counter[3].@covered.toDouble() / (jacocoReport.counter[3].@covered.toDouble() + jacocoReport.counter[3].@missed.toDouble()) * 100
                        
                        if (instructionCoverage < 80 || branchCoverage < 80) {
                            error("Coverage thresholds not met. Instruction: ${instructionCoverage}%, Branch: ${branchCoverage}%")
                        }
                    }
                }
            }
        }
        
        stage('Integration Tests') {
            steps {
                dir('spring-backend') {
                    sh '''
                        mvn failsafe:integration-test jacoco:report-integration
                    '''
                }
            }
            post {
                always {
                    // Publish integration test results
                    publishTestResults testResultsPattern: 'spring-backend/target/failsafe-reports/*.xml'
                    
                    // Publish integration coverage report
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'spring-backend/target/site/jacoco-it',
                        reportFiles: 'index.html',
                        reportName: 'Integration Test Coverage'
                    ])
                }
            }
        }
        
        stage('Code Quality') {
            parallel {
                stage('Checkstyle') {
                    steps {
                        dir('spring-backend') {
                            sh 'mvn checkstyle:check'
                        }
                    }
                    post {
                        always {
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'spring-backend/target/site/checkstyle',
                                reportFiles: 'checkstyle.html',
                                reportName: 'Checkstyle Report'
                            ])
                        }
                    }
                }
                stage('SpotBugs') {
                    steps {
                        dir('spring-backend') {
                            sh 'mvn spotbugs:check'
                        }
                    }
                    post {
                        always {
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'spring-backend/target/site/spotbugs',
                                reportFiles: 'spotbugs.html',
                                reportName: 'SpotBugs Report'
                            ])
                        }
                    }
                }
            }
        }
        
        stage('Build & Package') {
            steps {
                dir('spring-backend') {
                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
            }
        }
        
        stage('Dependency Scan - Nexus IQ') {
            steps {
                dir('spring-backend') {
                    sh '''
                        # Run Maven dependency check
                        mvn org.owasp:dependency-check-maven:check \
                            -DfailBuildOnCVSS=7 \
                            -DskipTestScope=true
                        
                        # Upload to Nexus IQ
                        curl -u ${NEXUS_IQ_USR}:${NEXUS_IQ_PSW} \
                             -F "file=@pom.xml" \
                             -F "applicationId=hobbie-backend-${BUILD_NUMBER}" \
                             -F "stage=build" \
                             https://nexus-iq.example.com/api/v2/scan/applications
                    '''
                }
            }
            post {
                always {
                    // Publish dependency check report
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'spring-backend/target/dependency-check-report',
                        reportFiles: 'index.html',
                        reportName: 'OWASP Dependency Check'
                    ])
                }
            }
        }
        
        stage('Package Application') {
            steps {
                dir('spring-backend') {
                    sh '''
                        mvn clean package -DskipTests
                    '''
                }
            }
        }
        
        stage('Docker Build') {
            steps {
                script {
                    def image = docker.build("${DOCKER_IMAGE_NAME}:${DOCKER_TAG}", "./spring-backend")
                    image.push()
                    image.push('latest')
                }
            }
        }
        
        stage('Image Scan - Trivy') {
            steps {
                script {
                    sh '''
                        trivy image --format json --output trivy-report.json ${DOCKER_IMAGE_NAME}:${DOCKER_TAG}
                        trivy image --exit-code 1 --severity HIGH,CRITICAL ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} || echo "Vulnerabilities found - review required"
                    '''
                    
                    // Upload scan results
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: '.',
                        reportFiles: 'trivy-report.html',
                        reportName: 'Trivy Security Scan'
                    ])
                }
            }
        }
        
        stage('Helm Chart Validation') {
            steps {
                script {
                    // Validate Helm chart syntax and values
                    sh '''
                        helm lint helm/hobbie-backend/
                        helm template hobbie-backend helm/hobbie-backend/ --values helm/hobbie-backend/values.yaml
                    '''
                }
            }
        }
        
        stage('Helm Deploy to Staging') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    // Deploy to staging using Helm
                    sh '''
                        helm upgrade --install hobbie-backend-staging helm/hobbie-backend/ \
                            --namespace staging \
                            --create-namespace \
                            --values helm/hobbie-backend/values.yaml \
                            --values helm/values-staging.yaml \
                            --set image.tag=${DOCKER_TAG} \
                            --wait \
                            --timeout 10m
                    '''
                }
            }
        }
        
        stage('Helm Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Deploy to production using Helm
                    sh '''
                        helm upgrade --install hobbie-backend-prod helm/hobbie-backend/ \
                            --namespace production \
                            --create-namespace \
                            --values helm/hobbie-backend/values.yaml \
                            --values helm/values-production.yaml \
                            --set image.tag=${DOCKER_TAG} \
                            --wait \
                            --timeout 15m
                    '''
                }
            }
        }
        
        stage('Integration Tests') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Run integration tests against staging environment
                    sh '''
                        docker run --rm \
                            -e API_URL=http://staging-backend:8080 \
                            ${DOCKER_IMAGE_NAME}:${DOCKER_TAG} \
                            mvn test -Dtest=**/*IT
                    '''
                }
            }
        }
    }
    
    post {
        always {
            // Archive artifacts
            archiveArtifacts artifacts: 'spring-backend/target/*.jar,spring-backend/target/*.war', allowEmptyArchive: true
            
            // Clean up workspace
            cleanWs()
        }
        
        success {
            script {
                if (env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop') {
                    slackSend(
                        channel: '#deployments',
                        color: 'good',
                        message: "✅ Backend build successful: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
                    )
                }
            }
        }
        
        failure {
            script {
                slackSend(
                    channel: '#deployments',
                    color: 'danger',
                    message: "❌ Backend build failed: ${env.JOB_NAME} - ${env.BUILD_NUMBER}\\nCheck console output: ${env.BUILD_URL}"
                )
            }
        }
        
        unstable {
            script {
                slackSend(
                    channel: '#deployments',
                    color: 'warning',
                    message: "⚠️ Backend build unstable: ${env.JOB_NAME} - ${env.BUILD_NUMBER}"
                )
            }
        }
    }
}

// Helper functions
def checkPRTitle(String title) {
    def pattern = /^(feat|fix|docs|style|refactor|test|chore)(\\(.+\\))?: .+/
    return title.matches(pattern)
}

def checkPRDescription(String description) {
    def requiredSections = ['## Type of Change', '## Testing', '## Checklist']
    return requiredSections.every { description.contains(it) }
}
